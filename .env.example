# ZYNTRA Platform — example configuration. Never commit real secrets.

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_DEFAULT_PROVIDER=deepseek
GATEWAY_BALANCE_STRATEGY=priority
GATEWAY_API_KEY=
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GATEWAY_RATE_LIMIT_PER_MINUTE=60
GATEWAY_STATS_REQUIRE_AUTH=true

# Configure at least one provider key for real LLM requests.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
KIMI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

AGENTS_HOST=0.0.0.0
AGENTS_PORT=8081
AGENTS_DATABASE_URL=sqlite+aiosqlite:///./data/agents.db
# Required for the Agents service; generate a long random value.
AGENTS_SECRET_KEY=
GATEWAY_INTERNAL_URL=http://gateway:8080
GATEWAY_API_KEY_INTERNAL=
AGENTS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

WEB_GATEWAY_PUBLIC_URL=http://localhost:8080
WEB_AGENTS_PUBLIC_URL=http://localhost:8081
