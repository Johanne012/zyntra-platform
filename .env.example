# ── ZYNTRA Platform ─────────────────────────────────────────
# Copy to .env and fill values. Never commit .env.

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_DEFAULT_PROVIDER=deepseek
# priority | round_robin | random | weighted
GATEWAY_BALANCE_STRATEGY=priority

# Security (production: set a long random key)
# When empty, chat/models/stats are open (local dev only).
GATEWAY_API_KEY=
# Comma-separated origins; use * only for throwaway local demos
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GATEWAY_RATE_LIMIT_PER_MINUTE=60
GATEWAY_STATS_REQUIRE_AUTH=true

# Provider keys (set at least one)
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
KIMI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Agents service
AGENTS_HOST=0.0.0.0
AGENTS_PORT=8081
AGENTS_DATABASE_URL=sqlite+aiosqlite:///./data/agents.db
AGENTS_SECRET_KEY=change-me-to-a-long-random-string
GATEWAY_INTERNAL_URL=http://gateway:8080
# Same value as GATEWAY_API_KEY when gateway auth is enabled
GATEWAY_API_KEY_INTERNAL=

# Web
WEB_GATEWAY_PUBLIC_URL=http://localhost:8080
WEB_AGENTS_PUBLIC_URL=http://localhost:8081
